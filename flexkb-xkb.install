## flexkb-xkb pacman install hook — purely informational.
##
## The drop-in compatibility is NOT enforced here; build-time
## `flexkb dropin-check` fails the package build if anything from
## upstream is missing. This hook only prints diagnostics and
## snapshots prior keyboard config to /var/lib/flexkb/ so a user
## can recover their original setup if they need to.

_snapshot_keyboard() {
    local snapshot="/var/lib/flexkb/pre-install-keyboard.txt"
    install -d -m 755 /var/lib/flexkb
    {
        echo "# Captured by flexkb-xkb pre_install on $(date -Iseconds)"
        echo
        if command -v localectl >/dev/null 2>&1; then
            localectl status 2>/dev/null
        fi
        echo
        echo "## /etc/X11/xorg.conf.d/00-keyboard.conf:"
        cat /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null || echo "(not present)"
        echo
        echo "## /etc/vconsole.conf:"
        cat /etc/vconsole.conf 2>/dev/null || echo "(not present)"
    } > "$snapshot" 2>/dev/null
    echo "  Saved current keyboard config to $snapshot"
}

_post_install_banner() {
    local layout variant
    if [[ -r /etc/X11/xorg.conf.d/00-keyboard.conf ]]; then
        layout=$(grep -oP 'XkbLayout"\s*"\K[^"]+' /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null | head -1)
        variant=$(grep -oP 'XkbVariant"\s*"\K[^"]+' /etc/X11/xorg.conf.d/00-keyboard.conf 2>/dev/null | head -1)
    fi
    echo
    echo "  flexkb-xkb is now providing /usr/share/X11/xkb."
    if [[ -n "$layout" ]]; then
        echo "  Your current X11 layout: ${layout}${variant:+($variant)}"
        echo "  This variant is preserved in flexkb's tree — your session keeps working."
    fi
    echo
    echo "  Next steps:"
    echo "    flexkb list                  # see all modular variants"
    echo "    flexkb info --xkb /usr/share/X11/xkb us   # what's modular vs upstream"
    echo "    flexkb migrate-suggest us dvorak-intl     # suggest a modular form"
    echo "    flexkb activate ru phonetic-dvorak        # apply a new variant"
    echo
    echo "  For Wayland users: install/start flexkb-imed (in the flexkb"
    echo "  package) for native input-method-v2 support. The static xkb"
    echo "  tree here is the fallback / X11 path."
    echo
    echo "  Per-user customisation: drop YAML files in ~/.config/flexkb/data/."
    echo "  See /usr/share/doc/flexkb/README.md."
    echo
    echo "  Rollback: pacman -S xkeyboard-config  (will remove flexkb-xkb)."
}

pre_install() {
    echo ":: flexkb-xkb: snapshotting current keyboard configuration..."
    _snapshot_keyboard
}

post_install() {
    _post_install_banner
}

pre_upgrade() {
    _snapshot_keyboard
}

post_upgrade() {
    _post_install_banner
}

post_remove() {
    echo
    echo "  flexkb-xkb removed. If pacman has just installed"
    echo "  xkeyboard-config in its place, your keyboard should continue"
    echo "  to work unchanged. Saved keyboard snapshots are in"
    echo "  /var/lib/flexkb/."
    echo "  Note: the flexkb-imed daemon (in the flexkb package) is"
    echo "  unaffected and continues to provide IME support."
    echo
}
